# Machine-local config (games paths, etc.)
.env

# Rust
/target/
**/target/
/target-*/
/dist/

# Runtime output next to the binary / cwd.
iw4l-artifacts

# Agent working memory. None of it is the product: the artifacts, the externals,
# the agent clones and the RE tooling and its bases all stay on this machine.
/context/

# Personal notes for Claude Code, kept local
CLAUDE.md

# Our own master server: certificates, keys, community descriptors, configs and build output
# stay on this machine (the CA itself lives in ~/.iw4l/ca, outside the repo).
/master/
*.iw4l-server
*.pem
*.key
*.crt
