# Copy to `.env` and set your games root (folder that contains game trees).
# Never commit `.env`.
#
# Counter-Strike installs for the CS viewmodels, sounds and HUD. Read at runtime from your own
# copy, never copied or shipped. Each is the game's `cstrike` folder. Use quotes and forward
# slashes, and keep them above any unquoted path with spaces (the .env parser stops at the
# first line it cannot read).
#
# IW4L_CSS: Counter-Strike: Source (the folder holds `cstrike_pak_dir.vpk`). Found
# automatically through your Steam libraries on Windows, so set it only to override that (a
# wrong path here disables the automatic search).
# IW4L_CSS="C:/Program Files (x86)/Steam/steamapps/common/Counter-Strike Source/cstrike"
#
# IW4L_CSTRIKE: Counter-Strike 1.6 (the folder holds `models/`). Used only when there is no
# Counter-Strike: Source, and never searched for: without CS:S, select your 1.6 folder here.
# Without either, the MW2 gun models stay.
# IW4L_CSTRIKE="C:/Program Files (x86)/Steam/steamapps/common/Half-Life/cstrike"

IW4L_GAMES=/path/to/cod-games

# Deploy target for `make deploy|publish|logs <channel>` (ssh user@host)
# and the iw4l root on that machine. Optional for local play.
# `make provision` uses the same host and IW4L_RELEASE_KEY.
IW4L_DEPLOY_HOST=user@host
IW4L_DEPLOY_ROOT=/srv/iw4l
# Private CA / TLS key used to sign master QUIC + release HTTPS certs. Keep it
# outside the repo.
IW4L_RELEASE_KEY=/path/to/release-ca

# Play with MW2 alone: ignore MW3/Black Ops installs found through Steam (their zones,
# e.g. MW3's weapon image bundle, add minutes to every map load).
IW4L_ONLY_MW2=1
